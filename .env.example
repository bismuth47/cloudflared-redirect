# ローカルPC側の設定 (Vercelには不要)
GIST_ID=ace74a8eec7a4f2ad49aa11c7e222412
GITHUB_TOKEN=ghp_xxxx

# EaglercraftXServer (Paper プラグイン) の待受ポート。HTTP と WebSocket を同居している
PORT=25565

# cloudflared の実行ファイル (PATH に無い場合)
CLOUDFLARED_PATH=cloudflared

# Vercel ページに表示するサーバー情報 (server.config.json と同じ内容。環境変数が優先)
SERVER_NAME=My Eaglercraft Server
MOTD=&6An EaglercraftX server
PROTOCOLS=1.5 / 1.8 / 1.12
